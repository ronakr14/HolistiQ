# app.py
from fastapi import FastAPI
from registry import ROUTES

def create_app():
    app = FastAPI()

    for config in ROUTES.values():
        endpoint = create_endpoint(config)

        app.add_api_route(
            config["path"],
            endpoint,
            methods=[config["method"]],
        )

    return app


